
# Name prefix applied to resource names and tags.
project = "aws-iac-task"

# Deployment environment label.
environment = "dev"

# Region to deploy into.
aws_region = "eu-west-2"

# VPC CIDR and how many public subnets (one per AZ) to create.
vpc_cidr            = "10.0.0.0/16"
public_subnet_count = 2

# EC2 instance type for the web server (t3.micro is Free Tier friendly).
instance_type = "t3.micro"

# CIDRs allowed to reach the web server on port 80.
# Lock this to your own IP for a private demo, e.g. ["203.0.113.4/32"].
allowed_http_cidrs = ["0.0.0.0/0"]
